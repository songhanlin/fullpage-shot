{
  "manifest_version": 3,
  "name": "整页截图 · 裁剪导出",
  "version": "1.0.0",
  "description": "对网页进行整页滚动截图，自由裁剪后一键导出为 Word / PDF。无需登录、无需付费。",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "整页截图（点击开始）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
